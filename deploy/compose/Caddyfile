{$BUZZ_DOMAIN} {
  encode zstd gzip

  # Unlimited: owner-only admin API of the Odoo connector (NIP-98 signed by the desktop app).
  handle /unlimited-api/admin/* {
    uri strip_prefix /unlimited-api
    reverse_proxy 172.30.0.1:8765
  }
  # Unlimited: phone line (Twilio call webhook + audio stream). The webhook path carries a secret.
  handle /unlimited-api/phone/twilio/* {
    uri strip_prefix /unlimited-api
    reverse_proxy 172.30.0.1:8765
  }
  # Unlimited: team photos (public, content-addressed file names).
  handle /unlimited-api/avatars/* {
    uri strip_prefix /unlimited-api
    reverse_proxy 172.30.0.1:8765
  }
  handle /unlimited-api/* {
    respond 404
  }

  # Unlimited: mobile pairing handshakes (Settings > Mobile) go to the pairing sidecar.
  handle /pair {
    reverse_proxy pair-relay:5000
  }

  # Unlimited: browsers get our private landing page; invites get our own page;
  # desktop/mobile websocket, NIP-11 and the relay API go to the relay unchanged.
  @browser {
    not header Upgrade *websocket*
    not header Accept *application/nostr+json*
  }
  @landing {
    path / /brand/* /dl/*
  }
  @invite {
    path /invite/*
  }
  @webapp {
    path /assets/*
  }
  handle @browser {
    # Unlimited: our own invite page (opens the app with buzz://join), not the Buzz web app.
    handle @invite {
      root * /srv/landing
      header X-Robots-Tag "noindex, nofollow"
      header Cache-Control "no-store"
      rewrite * /invite/index.html
      file_server
    }
    handle @landing {
      root * /srv/landing
      header X-Robots-Tag "noindex, nofollow"
      header /dl/* Cache-Control "private, no-store"
      header /dl/latest.json Access-Control-Allow-Origin "*"
      file_server
    }
    handle @webapp {
      root * /srv/web
      try_files {path} /index.html
      file_server
    }
    handle {
      reverse_proxy relay:3000
    }
  }
  handle {
    reverse_proxy relay:3000
  }
}

# Unlimited: design preview of the desktop UI (browser mode with demo data, no real data).
{$BUZZ_DOMAIN}:8443 {
  encode zstd gzip
  header X-Robots-Tag "noindex, nofollow"
  header Cache-Control "no-store"
  root * /srv/preview
  try_files {path} /index.html
  file_server
}
