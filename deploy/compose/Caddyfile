# Unlimited: behind Cloudflare. Trust only Cloudflare to say who the visitor is (CF-Connecting-IP);
# anyone hitting the server directly is identified by their own address.
{
  servers {
    trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
    client_ip_headers CF-Connecting-IP
  }
}

{$BUZZ_DOMAIN} {
  encode zstd gzip

  # Unlimited: browser hardening for every page on this domain.
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options DENY
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  # Unlimited: owner-only admin API of the Odoo connector (NIP-98 signed by the desktop app).
  handle /unlimited-api/admin/* {
    uri strip_prefix /unlimited-api
    reverse_proxy 172.30.0.1:8765 {
      header_up X-Real-IP {client_ip}
    }
  }
  # Unlimited: phone line (Twilio call webhook + audio stream). The webhook path carries a secret.
  handle /unlimited-api/phone/twilio/* {
    uri strip_prefix /unlimited-api
    reverse_proxy 172.30.0.1:8765 {
      header_up X-Real-IP {client_ip}
    }
  }
  # Unlimited: team photos (public, content-addressed file names).
  handle /unlimited-api/avatars/* {
    uri strip_prefix /unlimited-api
    reverse_proxy 172.30.0.1:8765 {
      header_up X-Real-IP {client_ip}
    }
  }
  # Unlimited: joining by invite (public, throttled; codes checked by the connector).
  handle /unlimited-api/join/* {
    uri strip_prefix /unlimited-api
    reverse_proxy 172.30.0.1:8765 {
      header_up X-Real-IP {client_ip}
    }
  }
  handle /unlimited-api/* {
    respond 404
  }

  # Unlimited: mobile pairing handshakes (Settings > Mobile) go to the pairing sidecar.
  handle /pair {
    reverse_proxy pair-relay:5000
  }

  # Unlimited: the relay information document (NIP-11) comes from the connector, which asks the relay with
  # the inner header and replaces its name, so the server does not announce which software it runs.
  @relayinfo {
    path /
    header Accept *application/nostr+json*
    not header Upgrade *websocket*
    not header X-Unlimited-Inner {$UNLIMITED_RELAYINFO_SECRET}
  }
  handle @relayinfo {
    rewrite * /relay-info/
    reverse_proxy 172.30.0.1:8765
  }
  @relayinfo2 {
    path /info
    not header X-Unlimited-Inner {$UNLIMITED_RELAYINFO_SECRET}
  }
  handle @relayinfo2 {
    rewrite * /relay-info/info
    reverse_proxy 172.30.0.1:8765
  }

  # Unlimited: browsers get our private landing page; invites get our own page;
  # desktop/mobile websocket, NIP-11 and the relay API go to the relay unchanged.
  @browser {
    not header Upgrade *websocket*
    not header Accept *application/nostr+json*
  }
  @landing {
    path / /brand/* /dl/*
  }
  @invite {
    path /invite/*
  }
  @webapp {
    path /assets/*
  }
  handle @browser {
    # Unlimited: our own invite page (opens the app with buzz://join), not the Buzz web app.
    handle @invite {
      root * /srv/landing
      header X-Robots-Tag "noindex, nofollow"
      header Cache-Control "no-store"
      rewrite * /invite/index.html
      file_server
    }
    handle @landing {
      root * /srv/landing
      header X-Robots-Tag "noindex, nofollow"
      header /dl/* Cache-Control "private, no-store"
      header /dl/latest.json Access-Control-Allow-Origin "*"
      file_server
    }
    handle @webapp {
      root * /srv/web
      try_files {path} /index.html
      file_server
    }
    handle {
      reverse_proxy relay:3000
    }
  }
  handle {
    reverse_proxy relay:3000
  }
}
