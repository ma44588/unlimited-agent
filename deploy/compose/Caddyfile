{$BUZZ_DOMAIN} {
  encode zstd gzip

  # Unlimited: browsers get the Buzz web pages (home, invites, repos); everything else
  # (desktop/mobile websocket, NIP-11, relay HTTP API) goes to the relay unchanged.
  @web {
    not header Upgrade *websocket*
    not header Accept *application/nostr+json*
    path / /invite/* /repos /repos/* /assets/* /favicon* /*.svg /*.png /*.ico /*.webmanifest
  }
  handle @web {
    root * /srv/web
    try_files {path} /index.html
    file_server
  }
  handle {
    reverse_proxy relay:3000
  }
}
